# Copy to .env and adjust. Never commit a real .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# SQLite needs no infrastructure. For production:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kyc_agent
DATABASE_URL=sqlite:///./kyc_agent.db

# Shared secret the voice platform presents on every tool call.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=local-dev-key

# Policy limits enforced server side.
MAX_IDENTITY_ATTEMPTS=2
ELIGIBILITY_POLICY_VERSION=v1.0.0
