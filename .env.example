# Copy to .env and adjust. Never commit a real .env.

ENVIRONMENT=local
LOG_LEVEL=INFO

# SQLite needs no infrastructure and is fine for tests and local work.
#
# Anything that must survive a restart needs Postgres. The application link
# flow in particular cannot work on ephemeral storage: the link lives 48 hours,
# so a wipe between sending the email and the applicant clicking it kills a
# valid link through nobody's fault.
#
# Neon (free tier) works well. Note the +psycopg driver and sslmode:
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./kyc_agent.db

# Shared secret the voice platform presents on every tool call.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=local-dev-key

# Policy limits enforced server side.
MAX_IDENTITY_ATTEMPTS=2
ELIGIBILITY_POLICY_VERSION=v1.0.0

# SMS delivery. "console" logs the passcode instead of sending it, which is the
# right setting for local work and for a demo with no provider wired up.
# Set to "msg91" and fill the three values below to send real messages.
SMS_PROVIDER=console

# MSG91 credentials, from the console after DLT registration completes.
# The template must define var_code and var_ttl as its variables.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Kept tight: the voice platform abandons a tool call after ten seconds.
SMS_TIMEOUT_SECONDS=3.0
SMS_MAX_RETRIES=1

# Which channel actually carries the passcode: "sms" or "email". SMS requires
# DLT registration as a business before it sends for real in India; email does
# not, so it is the practical choice for an individual running a demo.
OTP_DELIVERY_CHANNEL=sms

# Email delivery. "console" logs the passcode instead of sending it.
# Resend's onboarding@resend.dev sandbox sender needs only an API key and no
# domain verification, but only delivers to the address you signed up with.
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=Meridian Finance <onboarding@resend.dev>
EMAIL_TIMEOUT_SECONDS=3.0
EMAIL_MAX_RETRIES=1

# Where the emailed application link points. Must be the externally reachable
# origin — a link to localhost in a real email is dead on arrival.
PUBLIC_BASE_URL=http://localhost:8000
APPLICATION_LINK_TTL_HOURS=48

# Passcode policy.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=3
OTP_MAX_RESENDS=2
OTP_MAX_PER_WINDOW=3
OTP_RATE_WINDOW_SECONDS=900

# Echoes the passcode in the tool response so a demo can run without an SMS
# provider. The code never reaches agent_message, so the model cannot speak it.
# MUST be false in any real deployment.
OTP_DEMO_MODE=false
